APP_NAME="Coast to Coast College Fair"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://coasttocoastcollegefair.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@coasttocoastcollegefair.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Coast to Coast College Fair -------------------------------------------
# Stripe (test keys locally; the webhook secret comes from `stripe listen`)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Postmark — MAIL_MAILER=log locally, postmark everywhere else
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast

# Twilio — leave SID empty locally to bind the NullSms fake (card 1.4)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Where new-registration and payment alerts go, and the contact form's inbox
ADMIN_ALERTS_ENABLED=true
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=

# Who may tell this application the visitor's IP address. Both public forms and
# the plain interest POST throttle on it, so behind a load balancer or a CDN
# every visitor shares one throttle bucket until the proxy is trusted.
#
# Leave BLANK on a directly reachable host -- trusting `*` there lets anyone
# forge X-Forwarded-For and mint a fresh bucket per request, which removes the
# limit rather than loosening it. Use `*` only when a load balancer is the sole
# route in, or give a comma-separated CIDR list. See docs/11-deployment.md.
TRUSTED_PROXIES=

# The coordinator account CoordinatorSeeder provisions. Outside local/testing
# the seeder sets a random password nobody holds -- send a reset link.
COORDINATOR_NAME="Fair Coordinator"
COORDINATOR_EMAIL=

# The contact block rendered in the public footer, the email footer and the
# printable check form. The postal address is also the CAN-SPAM requirement
# for campaign mail, so it is not optional (doc 07).
FAIR_CONTACT_NAME="Meg Conner"
FAIR_CONTACT_EMAIL=contact@coasttocoastcollegefair.com
FAIR_CONTACT_PHONE="(423) 757-2845"
FAIR_CONTACT_ADDRESS1="171 Baylor School Road"
FAIR_CONTACT_ADDRESS2=
FAIR_CONTACT_CITY=Chattanooga
FAIR_CONTACT_STATE=TN
FAIR_CONTACT_POSTAL=37405

# Shared by the Filament theme and the email layout. The logo MUST be an
# absolute URL served from public/ -- a Vite-hashed path does not resolve in a
# mail client.
FAIR_BRAND_COLOR="#1d4ed8"
FAIR_BRAND_LOGO_URL=
